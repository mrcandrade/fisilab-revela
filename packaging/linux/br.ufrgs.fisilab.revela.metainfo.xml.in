<?xml version="1.0" encoding="UTF-8"?>
<!-- AppStream metadata (software centres, Flathub). Template: package.sh and the Flatpak
     manifest substitute @VERSION@ and @DATE@ from Cargo.toml and the build date. -->
<component type="desktop-application">
  <id>br.ufrgs.fisilab.revela</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>MIT OR Apache-2.0</project_license>
  <name>Revela</name>
  <summary>Revelação e catálogo de fotos — Suíte FisiLab (alternativa livre)</summary>
  <developer id="br.ufrgs.fisilab">
    <name>FisiLab — LARFIC</name>
  </developer>
  <description>
    <p>
      O Revela é um aplicativo livre de catálogo e revelação de fotos, com edição não destrutiva de arquivos raw.
      Faz parte da Suíte FisiLab, do LARFIC/UFRGS.
    </p>
    <p>
      Baseado no LightCraft, do ArtCraft Team e contribuidores (MIT ou Apache 2.0).
    </p>
  </description>
  <launchable type="desktop-id">br.ufrgs.fisilab.revela.desktop</launchable>
  <icon type="stock">br.ufrgs.fisilab.revela</icon>
  <url type="homepage">https://github.com/mrcandrade/larfic</url>
  <url type="bugtracker">https://github.com/mrcandrade/fisilab-revela/issues</url>
  <categories>
    <category>Graphics</category>
    <category>RasterGraphics</category>
    <category>Photography</category>
  </categories>
  <keywords>
    <keyword>photo</keyword>
    <keyword>image editor</keyword>
    <keyword>psd</keyword>
    <keyword>layers</keyword>
  </keywords>
  <branding>
    <color type="primary" scheme_preference="light">#9fd0ff</color>
    <color type="primary" scheme_preference="dark">#1f64ba</color>
  </branding>
  <requires>
    <display_length compare="ge">760</display_length>
  </requires>
  <supports>
    <control>keyboard</control>
    <control>pointing</control>
    <control>tablet</control>
  </supports>
  <provides>
    <binary>fisilab-revela</binary>
  </provides>
  <content_rating type="oars-1.1"/>
  <releases>
    <release version="@VERSION@" date="@DATE@"/>
  </releases>
</component>
